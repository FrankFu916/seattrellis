# v1.9.0 sdist contents: the package plus public documentation only.
# Internal planning, audits, product decisions, migration guides and parity
# tooling stay out of the published artifact (PD-D19 / public communications
# policy).
include README.md README.en.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include LICENSE NOTICE
recursive-include examples *
prune outputs
prune exports
prune snapshots
prune private
prune data
prune real_students
prune real_classes
prune examples/outputs
prune examples/exports
prune examples/snapshots
global-exclude .DS_Store
