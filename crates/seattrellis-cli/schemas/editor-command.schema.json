{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frankfu916.github.io/seattrellis/schemas/editor-command.schema.json",
  "title": "SeatTrellis Editor Command",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "apply"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "operations": {
            "minItems": 1
          }
        },
        "required": [
          "operations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "undo",
              "redo"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "operations": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "kind": {
      "const": "seattrellis_editor_command",
      "title": "Kind",
      "type": "string"
    },
    "protocol_version": {
      "const": "1.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "command_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Command Id",
      "type": "string"
    },
    "draft_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Draft Id",
      "type": "string"
    },
    "base_revision": {
      "minimum": 0,
      "title": "Base Revision",
      "type": "integer"
    },
    "action": {
      "enum": [
        "apply",
        "undo",
        "redo"
      ],
      "title": "Action",
      "type": "string"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "batch_move": "#/definitions/BatchMoveOperation",
            "lock_seat": "#/definitions/LockSeatOperation",
            "lock_student": "#/definitions/LockStudentOperation",
            "move_student": "#/definitions/MoveStudentOperation",
            "seat_student": "#/definitions/SeatStudentOperation",
            "swap_students": "#/definitions/SwapStudentsOperation",
            "unlock_seat": "#/definitions/UnlockSeatOperation",
            "unlock_student": "#/definitions/UnlockStudentOperation",
            "unseat_student": "#/definitions/UnseatStudentOperation"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/definitions/SwapStudentsOperation"
          },
          {
            "$ref": "#/definitions/MoveStudentOperation"
          },
          {
            "$ref": "#/definitions/BatchMoveOperation"
          },
          {
            "$ref": "#/definitions/SeatStudentOperation"
          },
          {
            "$ref": "#/definitions/UnseatStudentOperation"
          },
          {
            "$ref": "#/definitions/LockStudentOperation"
          },
          {
            "$ref": "#/definitions/UnlockStudentOperation"
          },
          {
            "$ref": "#/definitions/LockSeatOperation"
          },
          {
            "$ref": "#/definitions/UnlockSeatOperation"
          }
        ]
      },
      "maxItems": 100,
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "protocol_version",
    "command_id",
    "draft_id",
    "base_revision",
    "action"
  ],
  "type": "object",
  "definitions": {
    "BatchMoveItem": {
      "additionalProperties": false,
      "properties": {
        "student_key": {
          "minLength": 1,
          "title": "Student Key",
          "type": "string"
        },
        "seat_id": {
          "minLength": 1,
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "student_key",
        "seat_id"
      ],
      "title": "BatchMoveItem",
      "type": "object"
    },
    "BatchMoveOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "batch_move",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/BatchMovePayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "BatchMoveOperation",
      "type": "object"
    },
    "BatchMovePayload": {
      "additionalProperties": false,
      "properties": {
        "moves": {
          "items": {
            "$ref": "#/definitions/BatchMoveItem"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Moves",
          "type": "array"
        }
      },
      "required": [
        "moves"
      ],
      "title": "BatchMovePayload",
      "type": "object"
    },
    "LockSeatOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lock_seat",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/SeatPayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "LockSeatOperation",
      "type": "object"
    },
    "LockStudentOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "lock_student",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/StudentPayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "LockStudentOperation",
      "type": "object"
    },
    "MoveStudentOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "move_student",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/StudentSeatPayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "MoveStudentOperation",
      "type": "object"
    },
    "SeatPayload": {
      "additionalProperties": false,
      "properties": {
        "seat_id": {
          "minLength": 1,
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "seat_id"
      ],
      "title": "SeatPayload",
      "type": "object"
    },
    "SeatStudentOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "seat_student",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/StudentSeatPayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "SeatStudentOperation",
      "type": "object"
    },
    "StudentPayload": {
      "additionalProperties": false,
      "properties": {
        "student_key": {
          "minLength": 1,
          "title": "Student Key",
          "type": "string"
        }
      },
      "required": [
        "student_key"
      ],
      "title": "StudentPayload",
      "type": "object"
    },
    "StudentSeatPayload": {
      "additionalProperties": false,
      "properties": {
        "student_key": {
          "minLength": 1,
          "title": "Student Key",
          "type": "string"
        },
        "seat_id": {
          "minLength": 1,
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "student_key",
        "seat_id"
      ],
      "title": "StudentSeatPayload",
      "type": "object"
    },
    "SwapStudentsOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "swap_students",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/SwapStudentsPayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "SwapStudentsOperation",
      "type": "object"
    },
    "SwapStudentsPayload": {
      "additionalProperties": false,
      "properties": {
        "first_student": {
          "minLength": 1,
          "title": "First Student",
          "type": "string"
        },
        "second_student": {
          "minLength": 1,
          "title": "Second Student",
          "type": "string"
        }
      },
      "required": [
        "first_student",
        "second_student"
      ],
      "title": "SwapStudentsPayload",
      "type": "object"
    },
    "UnlockSeatOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unlock_seat",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/SeatPayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "UnlockSeatOperation",
      "type": "object"
    },
    "UnlockStudentOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unlock_student",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/StudentPayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "UnlockStudentOperation",
      "type": "object"
    },
    "UnseatStudentOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unseat_student",
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/StudentPayload"
        }
      },
      "required": [
        "kind",
        "payload"
      ],
      "title": "UnseatStudentOperation",
      "type": "object"
    }
  },
  "x-seattrellis-artifact": "editor-command",
  "x-seattrellis-schema-version": "1.0"
}
