{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frankfu916.github.io/seattrellis/schemas/ruleset.schema.json",
  "title": "SeatTrellis RuleSet",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "default": 42,
      "title": "Seed",
      "type": "integer"
    },
    "hard": {
      "$ref": "#/definitions/HardRules"
    },
    "soft": {
      "$ref": "#/definitions/SoftRules"
    },
    "groups": {
      "items": {
        "$ref": "#/definitions/GroupRule"
      },
      "title": "Groups",
      "type": "array"
    }
  },
  "type": "object",
  "definitions": {
    "AvoidRecentNeighborsRule": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "relation_types": {
          "items": {
            "$ref": "#/definitions/NeighborRelationType"
          },
          "title": "Relation Types",
          "type": "array"
        },
        "lookback": {
          "default": 4,
          "title": "Lookback",
          "type": "integer"
        },
        "max_recent_count": {
          "default": 1,
          "title": "Max Recent Count",
          "type": "integer"
        },
        "within_distance": {
          "default": 2,
          "title": "Within Distance",
          "type": "integer"
        }
      },
      "title": "AvoidRecentNeighborsRule",
      "type": "object"
    },
    "CoolingRule": {
      "additionalProperties": false,
      "description": "Cooling period between repeated desk-mate / neighbor assignments.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "cooling_period": {
          "default": 3,
          "title": "Cooling Period",
          "type": "integer"
        },
        "relation_types": {
          "items": {
            "type": "string"
          },
          "title": "Relation Types",
          "type": "array"
        }
      },
      "title": "CoolingRule",
      "type": "object"
    },
    "FairRotationRule": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "avoid_repeating_categories": {
          "items": {
            "$ref": "#/definitions/SeatPositionCategory"
          },
          "title": "Avoid Repeating Categories",
          "type": "array"
        },
        "lookback": {
          "default": 4,
          "title": "Lookback",
          "type": "integer"
        }
      },
      "title": "FairRotationRule",
      "type": "object"
    },
    "FixedSeatRule": {
      "additionalProperties": false,
      "properties": {
        "student": {
          "title": "Student",
          "type": "string"
        },
        "seat_id": {
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "student",
        "seat_id"
      ],
      "title": "FixedSeatRule",
      "type": "object"
    },
    "GroupRule": {
      "additionalProperties": false,
      "description": "Defines a named group of students for separation or togetherness rules.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "students": {
          "items": {
            "type": "string"
          },
          "title": "Students",
          "type": "array"
        },
        "separate": {
          "default": false,
          "title": "Separate",
          "type": "boolean"
        },
        "together": {
          "default": false,
          "title": "Together",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "GroupRule",
      "type": "object"
    },
    "HardRules": {
      "additionalProperties": false,
      "properties": {
        "fixed_seats": {
          "items": {
            "$ref": "#/definitions/FixedSeatRule"
          },
          "title": "Fixed Seats",
          "type": "array"
        },
        "must_be_adjacent": {
          "items": {
            "$ref": "#/definitions/PairRule"
          },
          "title": "Must Be Adjacent",
          "type": "array"
        },
        "cannot_be_adjacent": {
          "items": {
            "$ref": "#/definitions/PairRule"
          },
          "title": "Cannot Be Adjacent",
          "type": "array"
        },
        "min_distance": {
          "items": {
            "$ref": "#/definitions/MinDistanceRule"
          },
          "title": "Min Distance",
          "type": "array"
        }
      },
      "title": "HardRules",
      "type": "object"
    },
    "MentorPairingRule": {
      "additionalProperties": false,
      "description": "Pair high- and low-ranked students through a soft proximity goal.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "mentor_percentile": {
          "default": 0.75,
          "title": "Mentor Percentile",
          "type": "number"
        },
        "learner_percentile": {
          "default": 0.25,
          "title": "Learner Percentile",
          "type": "number"
        },
        "relation": {
          "default": "desk_mate",
          "enum": [
            "desk_mate",
            "adjacent_any"
          ],
          "title": "Relation",
          "type": "string"
        },
        "avoid_recent_repeats": {
          "default": true,
          "title": "Avoid Recent Repeats",
          "type": "boolean"
        },
        "history_lookback": {
          "default": 4,
          "title": "History Lookback",
          "type": "integer"
        }
      },
      "title": "MentorPairingRule",
      "type": "object"
    },
    "MinDistanceRule": {
      "additionalProperties": false,
      "properties": {
        "students": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Students",
          "type": "array"
        },
        "distance": {
          "title": "Distance",
          "type": "number"
        },
        "metric": {
          "default": "euclidean",
          "enum": [
            "euclidean",
            "graph"
          ],
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "students",
        "distance"
      ],
      "title": "MinDistanceRule",
      "type": "object"
    },
    "NeighborRelationType": {
      "enum": [
        "desk_mate",
        "horizontal",
        "vertical",
        "diagonal",
        "adjacent_any",
        "within_distance"
      ],
      "title": "NeighborRelationType",
      "type": "string"
    },
    "PairRule": {
      "additionalProperties": false,
      "properties": {
        "students": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Students",
          "type": "array"
        }
      },
      "required": [
        "students"
      ],
      "title": "PairRule",
      "type": "object"
    },
    "ScoreDistributionRule": {
      "additionalProperties": false,
      "description": "Balance score-rank means across physical rows or named seat groups.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "scope": {
          "default": "row",
          "enum": [
            "row",
            "group"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "title": "ScoreDistributionRule",
      "type": "object"
    },
    "ScorePositionRule": {
      "additionalProperties": false,
      "description": "Place score ranks toward the front or back without forcing an order.\n\nScores are converted to rank percentiles by the objective compiler, so\nschools can use any grading scale and ties remain neutral.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "direction": {
          "default": "high_front",
          "enum": [
            "high_front",
            "high_back"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "title": "ScorePositionRule",
      "type": "object"
    },
    "SeatPositionCategory": {
      "enum": [
        "front",
        "back",
        "middle",
        "side",
        "corner",
        "near_window",
        "near_door",
        "near_platform",
        "near_ac",
        "unknown"
      ],
      "title": "SeatPositionCategory",
      "type": "string"
    },
    "SoftRules": {
      "additionalProperties": false,
      "properties": {
        "vision_front": {
          "$ref": "#/definitions/WeightedRule"
        },
        "height_back": {
          "$ref": "#/definitions/WeightedRule"
        },
        "randomize": {
          "$ref": "#/definitions/WeightedRule"
        },
        "score_balance": {
          "$ref": "#/definitions/WeightedRule"
        },
        "score_position": {
          "$ref": "#/definitions/ScorePositionRule"
        },
        "score_distribution": {
          "$ref": "#/definitions/ScoreDistributionRule"
        },
        "mentor_pairing": {
          "$ref": "#/definitions/MentorPairingRule"
        },
        "fair_rotation": {
          "$ref": "#/definitions/FairRotationRule"
        },
        "avoid_recent_neighbors": {
          "$ref": "#/definitions/AvoidRecentNeighborsRule"
        },
        "cooling": {
          "$ref": "#/definitions/CoolingRule"
        }
      },
      "title": "SoftRules",
      "type": "object"
    },
    "WeightedRule": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "title": "WeightedRule",
      "type": "object"
    }
  },
  "x-seattrellis-artifact": "ruleset",
  "x-seattrellis-schema-version": 1
}
