{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frankfu916.github.io/seattrellis/schemas/seating-snapshot.schema.json",
  "title": "SeatTrellis Seating Snapshot",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "seed": {
      "default": 42,
      "title": "Seed",
      "type": "integer"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "students": {
      "items": {
        "$ref": "#/definitions/Student"
      },
      "title": "Students",
      "type": "array"
    },
    "layout": {
      "$ref": "#/definitions/ClassroomLayout"
    },
    "rules": {
      "$ref": "#/definitions/RuleSet"
    },
    "assignments": {
      "items": {
        "$ref": "#/definitions/SeatAssignment"
      },
      "title": "Assignments",
      "type": "array"
    },
    "solver_status": {
      "title": "Solver Status",
      "type": "string"
    },
    "objective_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Objective Value"
    },
    "metrics": {
      "additionalProperties": true,
      "title": "Metrics",
      "type": "object"
    }
  },
  "required": [
    "students",
    "layout",
    "rules",
    "assignments",
    "solver_status"
  ],
  "type": "object",
  "definitions": {
    "AdjacencyConfig": {
      "description": "Rules for generating a seat adjacency graph.",
      "properties": {
        "include_horizontal": {
          "default": true,
          "title": "Include Horizontal",
          "type": "boolean"
        },
        "include_vertical": {
          "default": false,
          "title": "Include Vertical",
          "type": "boolean"
        },
        "include_diagonal": {
          "default": false,
          "title": "Include Diagonal",
          "type": "boolean"
        },
        "max_row_delta": {
          "default": 1,
          "title": "Max Row Delta",
          "type": "integer"
        },
        "max_col_delta": {
          "default": 1,
          "title": "Max Col Delta",
          "type": "integer"
        },
        "max_distance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Distance"
        },
        "use_xy_distance": {
          "default": true,
          "title": "Use Xy Distance",
          "type": "boolean"
        },
        "custom_edges": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Custom Edges",
          "type": "array"
        }
      },
      "title": "AdjacencyConfig",
      "type": "object"
    },
    "AvoidRecentNeighborsRule": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "relation_types": {
          "items": {
            "$ref": "#/definitions/NeighborRelationType"
          },
          "title": "Relation Types",
          "type": "array"
        },
        "lookback": {
          "default": 4,
          "title": "Lookback",
          "type": "integer"
        },
        "max_recent_count": {
          "default": 1,
          "title": "Max Recent Count",
          "type": "integer"
        },
        "within_distance": {
          "default": 2,
          "title": "Within Distance",
          "type": "integer"
        }
      },
      "title": "AvoidRecentNeighborsRule",
      "type": "object"
    },
    "ClassroomLayout": {
      "description": "A classroom layout represented by seat nodes and adjacency settings.",
      "properties": {
        "layout_id": {
          "default": "default-layout",
          "title": "Layout Id",
          "type": "string"
        },
        "name": {
          "default": "Classroom",
          "title": "Name",
          "type": "string"
        },
        "seats": {
          "items": {
            "$ref": "#/definitions/SeatNode"
          },
          "title": "Seats",
          "type": "array"
        },
        "adjacency": {
          "$ref": "#/definitions/AdjacencyConfig"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "seats"
      ],
      "title": "ClassroomLayout",
      "type": "object"
    },
    "CoolingRule": {
      "additionalProperties": false,
      "description": "Cooling period between repeated desk-mate / neighbor assignments.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "cooling_period": {
          "default": 3,
          "title": "Cooling Period",
          "type": "integer"
        },
        "relation_types": {
          "items": {
            "type": "string"
          },
          "title": "Relation Types",
          "type": "array"
        }
      },
      "title": "CoolingRule",
      "type": "object"
    },
    "FairRotationRule": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "avoid_repeating_categories": {
          "items": {
            "$ref": "#/definitions/SeatPositionCategory"
          },
          "title": "Avoid Repeating Categories",
          "type": "array"
        },
        "lookback": {
          "default": 4,
          "title": "Lookback",
          "type": "integer"
        }
      },
      "title": "FairRotationRule",
      "type": "object"
    },
    "FixedSeatRule": {
      "additionalProperties": false,
      "properties": {
        "student": {
          "title": "Student",
          "type": "string"
        },
        "seat_id": {
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "student",
        "seat_id"
      ],
      "title": "FixedSeatRule",
      "type": "object"
    },
    "GroupRule": {
      "additionalProperties": false,
      "description": "Defines a named group of students for separation or togetherness rules.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "students": {
          "items": {
            "type": "string"
          },
          "title": "Students",
          "type": "array"
        },
        "separate": {
          "default": false,
          "title": "Separate",
          "type": "boolean"
        },
        "together": {
          "default": false,
          "title": "Together",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "title": "GroupRule",
      "type": "object"
    },
    "HardRules": {
      "additionalProperties": false,
      "properties": {
        "fixed_seats": {
          "items": {
            "$ref": "#/definitions/FixedSeatRule"
          },
          "title": "Fixed Seats",
          "type": "array"
        },
        "must_be_adjacent": {
          "items": {
            "$ref": "#/definitions/PairRule"
          },
          "title": "Must Be Adjacent",
          "type": "array"
        },
        "cannot_be_adjacent": {
          "items": {
            "$ref": "#/definitions/PairRule"
          },
          "title": "Cannot Be Adjacent",
          "type": "array"
        },
        "min_distance": {
          "items": {
            "$ref": "#/definitions/MinDistanceRule"
          },
          "title": "Min Distance",
          "type": "array"
        }
      },
      "title": "HardRules",
      "type": "object"
    },
    "MentorPairingRule": {
      "additionalProperties": false,
      "description": "Pair high- and low-ranked students through a soft proximity goal.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "mentor_percentile": {
          "default": 0.75,
          "title": "Mentor Percentile",
          "type": "number"
        },
        "learner_percentile": {
          "default": 0.25,
          "title": "Learner Percentile",
          "type": "number"
        },
        "relation": {
          "default": "desk_mate",
          "enum": [
            "desk_mate",
            "adjacent_any"
          ],
          "title": "Relation",
          "type": "string"
        },
        "avoid_recent_repeats": {
          "default": true,
          "title": "Avoid Recent Repeats",
          "type": "boolean"
        },
        "history_lookback": {
          "default": 4,
          "title": "History Lookback",
          "type": "integer"
        }
      },
      "title": "MentorPairingRule",
      "type": "object"
    },
    "MinDistanceRule": {
      "additionalProperties": false,
      "properties": {
        "students": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Students",
          "type": "array"
        },
        "distance": {
          "title": "Distance",
          "type": "number"
        },
        "metric": {
          "default": "euclidean",
          "enum": [
            "euclidean",
            "graph"
          ],
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "students",
        "distance"
      ],
      "title": "MinDistanceRule",
      "type": "object"
    },
    "NeighborRelationType": {
      "enum": [
        "desk_mate",
        "horizontal",
        "vertical",
        "diagonal",
        "adjacent_any",
        "within_distance"
      ],
      "title": "NeighborRelationType",
      "type": "string"
    },
    "PairRule": {
      "additionalProperties": false,
      "properties": {
        "students": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Students",
          "type": "array"
        }
      },
      "required": [
        "students"
      ],
      "title": "PairRule",
      "type": "object"
    },
    "RuleSet": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "default": 42,
          "title": "Seed",
          "type": "integer"
        },
        "hard": {
          "$ref": "#/definitions/HardRules"
        },
        "soft": {
          "$ref": "#/definitions/SoftRules"
        },
        "groups": {
          "items": {
            "$ref": "#/definitions/GroupRule"
          },
          "title": "Groups",
          "type": "array"
        }
      },
      "title": "RuleSet",
      "type": "object"
    },
    "ScoreDistributionRule": {
      "additionalProperties": false,
      "description": "Balance score-rank means across physical rows or named seat groups.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "scope": {
          "default": "row",
          "enum": [
            "row",
            "group"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "title": "ScoreDistributionRule",
      "type": "object"
    },
    "ScorePositionRule": {
      "additionalProperties": false,
      "description": "Place score ranks toward the front or back without forcing an order.\n\nScores are converted to rank percentiles by the objective compiler, so\nschools can use any grading scale and ties remain neutral.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        },
        "direction": {
          "default": "high_front",
          "enum": [
            "high_front",
            "high_back"
          ],
          "title": "Direction",
          "type": "string"
        }
      },
      "title": "ScorePositionRule",
      "type": "object"
    },
    "SeatAssignment": {
      "properties": {
        "student_key": {
          "title": "Student Key",
          "type": "string"
        },
        "student_name": {
          "title": "Student Name",
          "type": "string"
        },
        "seat_id": {
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "student_key",
        "student_name",
        "seat_id"
      ],
      "title": "SeatAssignment",
      "type": "object"
    },
    "SeatNode": {
      "description": "A physical or logical seat node in the classroom graph.",
      "properties": {
        "seat_id": {
          "title": "Seat Id",
          "type": "string"
        },
        "row": {
          "title": "Row",
          "type": "integer"
        },
        "col": {
          "title": "Col",
          "type": "integer"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "near_window": {
          "default": false,
          "title": "Near Window",
          "type": "boolean"
        },
        "near_door": {
          "default": false,
          "title": "Near Door",
          "type": "boolean"
        },
        "near_platform": {
          "default": false,
          "title": "Near Platform",
          "type": "boolean"
        },
        "near_ac": {
          "default": false,
          "title": "Near Ac",
          "type": "boolean"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "seat_id",
        "row",
        "col"
      ],
      "title": "SeatNode",
      "type": "object"
    },
    "SeatPositionCategory": {
      "enum": [
        "front",
        "back",
        "middle",
        "side",
        "corner",
        "near_window",
        "near_door",
        "near_platform",
        "near_ac",
        "unknown"
      ],
      "title": "SeatPositionCategory",
      "type": "string"
    },
    "SoftRules": {
      "additionalProperties": false,
      "properties": {
        "vision_front": {
          "$ref": "#/definitions/WeightedRule"
        },
        "height_back": {
          "$ref": "#/definitions/WeightedRule"
        },
        "randomize": {
          "$ref": "#/definitions/WeightedRule"
        },
        "score_balance": {
          "$ref": "#/definitions/WeightedRule"
        },
        "score_position": {
          "$ref": "#/definitions/ScorePositionRule"
        },
        "score_distribution": {
          "$ref": "#/definitions/ScoreDistributionRule"
        },
        "mentor_pairing": {
          "$ref": "#/definitions/MentorPairingRule"
        },
        "fair_rotation": {
          "$ref": "#/definitions/FairRotationRule"
        },
        "avoid_recent_neighbors": {
          "$ref": "#/definitions/AvoidRecentNeighborsRule"
        },
        "cooling": {
          "$ref": "#/definitions/CoolingRule"
        }
      },
      "title": "SoftRules",
      "type": "object"
    },
    "Student": {
      "description": "A student record.\n\nOnly one stable identifier is required: either ``student_id`` or ``name``.\nProject-specific columns can be stored in ``attributes``.",
      "properties": {
        "student_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Student Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "gender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gender"
        },
        "height_cm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Cm"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "vision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vision"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "needs": {
          "items": {
            "type": "string"
          },
          "title": "Needs",
          "type": "array"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        }
      },
      "title": "Student",
      "type": "object"
    },
    "WeightedRule": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "title": "Weight",
          "type": "integer"
        }
      },
      "title": "WeightedRule",
      "type": "object"
    }
  },
  "x-seattrellis-artifact": "seating-snapshot",
  "x-seattrellis-schema-version": "1.0"
}
