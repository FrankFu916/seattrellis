{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frankfu916.github.io/seattrellis/schemas/candidate-set.schema.json",
  "title": "SeatTrellis Candidate Set",
  "type": "object",
  "properties": {
    "schema_version": {
      "title": "Schema Version",
      "default": "0.2.2",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "default": "candidate_set",
      "enum": [
        "candidate_set"
      ],
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "title": "Metadata",
      "type": "object"
    },
    "candidates": {
      "title": "Candidates",
      "type": "array",
      "items": {
        "$ref": "#/definitions/CandidatePlan"
      }
    },
    "recommended_candidate_id": {
      "title": "Recommended Candidate Id",
      "type": "string"
    },
    "warnings": {
      "title": "Warnings",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "candidates",
    "recommended_candidate_id"
  ],
  "definitions": {
    "Student": {
      "title": "Student",
      "description": "A student record.\n\nOnly one stable identifier is required: either ``student_id`` or ``name``.\nProject-specific columns can be stored in ``attributes``.",
      "type": "object",
      "properties": {
        "student_id": {
          "title": "Student Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "gender": {
          "title": "Gender",
          "type": "string"
        },
        "height_cm": {
          "title": "Height Cm",
          "type": "number"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "vision": {
          "title": "Vision",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        },
        "tags": {
          "title": "Tags",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needs": {
          "title": "Needs",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "title": "Attributes",
          "type": "object"
        }
      }
    },
    "SeatNode": {
      "title": "SeatNode",
      "description": "A physical or logical seat node in the classroom graph.",
      "type": "object",
      "properties": {
        "seat_id": {
          "title": "Seat Id",
          "type": "string"
        },
        "row": {
          "title": "Row",
          "type": "integer"
        },
        "col": {
          "title": "Col",
          "type": "integer"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "enabled": {
          "title": "Enabled",
          "default": true,
          "type": "boolean"
        },
        "zone": {
          "title": "Zone",
          "type": "string"
        },
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "near_window": {
          "title": "Near Window",
          "default": false,
          "type": "boolean"
        },
        "near_door": {
          "title": "Near Door",
          "default": false,
          "type": "boolean"
        },
        "near_platform": {
          "title": "Near Platform",
          "default": false,
          "type": "boolean"
        },
        "near_ac": {
          "title": "Near Ac",
          "default": false,
          "type": "boolean"
        },
        "tags": {
          "title": "Tags",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "seat_id",
        "row",
        "col"
      ]
    },
    "AdjacencyConfig": {
      "title": "AdjacencyConfig",
      "description": "Rules for generating a seat adjacency graph.",
      "type": "object",
      "properties": {
        "include_horizontal": {
          "title": "Include Horizontal",
          "default": true,
          "type": "boolean"
        },
        "include_vertical": {
          "title": "Include Vertical",
          "default": false,
          "type": "boolean"
        },
        "include_diagonal": {
          "title": "Include Diagonal",
          "default": false,
          "type": "boolean"
        },
        "max_row_delta": {
          "title": "Max Row Delta",
          "default": 1,
          "type": "integer"
        },
        "max_col_delta": {
          "title": "Max Col Delta",
          "default": 1,
          "type": "integer"
        },
        "max_distance": {
          "title": "Max Distance",
          "type": "number"
        },
        "use_xy_distance": {
          "title": "Use Xy Distance",
          "default": true,
          "type": "boolean"
        },
        "custom_edges": {
          "title": "Custom Edges",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "ClassroomLayout": {
      "title": "ClassroomLayout",
      "description": "A classroom layout represented by seat nodes and adjacency settings.",
      "type": "object",
      "properties": {
        "layout_id": {
          "title": "Layout Id",
          "default": "default-layout",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "default": "Classroom",
          "type": "string"
        },
        "seats": {
          "title": "Seats",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SeatNode"
          }
        },
        "adjacency": {
          "$ref": "#/definitions/AdjacencyConfig"
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "seats"
      ]
    },
    "FixedSeatRule": {
      "title": "FixedSeatRule",
      "type": "object",
      "properties": {
        "student": {
          "title": "Student",
          "type": "string"
        },
        "seat_id": {
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "student",
        "seat_id"
      ],
      "additionalProperties": false
    },
    "PairRule": {
      "title": "PairRule",
      "type": "object",
      "properties": {
        "students": {
          "title": "Students",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "students"
      ],
      "additionalProperties": false
    },
    "MinDistanceRule": {
      "title": "MinDistanceRule",
      "type": "object",
      "properties": {
        "students": {
          "title": "Students",
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ]
        },
        "distance": {
          "title": "Distance",
          "type": "number"
        },
        "metric": {
          "title": "Metric",
          "default": "euclidean",
          "enum": [
            "euclidean",
            "graph"
          ],
          "type": "string"
        }
      },
      "required": [
        "students",
        "distance"
      ],
      "additionalProperties": false
    },
    "HardRules": {
      "title": "HardRules",
      "type": "object",
      "properties": {
        "fixed_seats": {
          "title": "Fixed Seats",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FixedSeatRule"
          }
        },
        "must_be_adjacent": {
          "title": "Must Be Adjacent",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PairRule"
          }
        },
        "cannot_be_adjacent": {
          "title": "Cannot Be Adjacent",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PairRule"
          }
        },
        "min_distance": {
          "title": "Min Distance",
          "type": "array",
          "items": {
            "$ref": "#/definitions/MinDistanceRule"
          }
        }
      },
      "additionalProperties": false
    },
    "WeightedRule": {
      "title": "WeightedRule",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "title": "Weight",
          "default": 1,
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "ScorePositionRule": {
      "title": "ScorePositionRule",
      "description": "Place score ranks toward the front or back without forcing an order.\n\nScores are converted to rank percentiles by the objective compiler, so\nschools can use any grading scale and ties remain neutral.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "title": "Weight",
          "default": 1,
          "type": "integer"
        },
        "direction": {
          "title": "Direction",
          "default": "high_front",
          "enum": [
            "high_front",
            "high_back"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ScoreDistributionRule": {
      "title": "ScoreDistributionRule",
      "description": "Balance score-rank means across physical rows or named seat groups.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "title": "Weight",
          "default": 1,
          "type": "integer"
        },
        "scope": {
          "title": "Scope",
          "default": "row",
          "enum": [
            "row",
            "group"
          ],
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "MentorPairingRule": {
      "title": "MentorPairingRule",
      "description": "Pair high- and low-ranked students through a soft proximity goal.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "title": "Weight",
          "default": 1,
          "type": "integer"
        },
        "mentor_percentile": {
          "title": "Mentor Percentile",
          "default": 0.75,
          "type": "number"
        },
        "learner_percentile": {
          "title": "Learner Percentile",
          "default": 0.25,
          "type": "number"
        },
        "relation": {
          "title": "Relation",
          "default": "desk_mate",
          "enum": [
            "desk_mate",
            "adjacent_any"
          ],
          "type": "string"
        },
        "avoid_recent_repeats": {
          "title": "Avoid Recent Repeats",
          "default": true,
          "type": "boolean"
        },
        "history_lookback": {
          "title": "History Lookback",
          "default": 4,
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "SeatPositionCategory": {
      "title": "SeatPositionCategory",
      "description": "An enumeration.",
      "enum": [
        "front",
        "back",
        "middle",
        "side",
        "corner",
        "near_window",
        "near_door",
        "near_platform",
        "near_ac",
        "unknown"
      ],
      "type": "string"
    },
    "FairRotationRule": {
      "title": "FairRotationRule",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "title": "Weight",
          "default": 1,
          "type": "integer"
        },
        "avoid_repeating_categories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SeatPositionCategory"
          }
        },
        "lookback": {
          "title": "Lookback",
          "default": 4,
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "NeighborRelationType": {
      "title": "NeighborRelationType",
      "description": "An enumeration.",
      "enum": [
        "desk_mate",
        "horizontal",
        "vertical",
        "diagonal",
        "adjacent_any",
        "within_distance"
      ],
      "type": "string"
    },
    "AvoidRecentNeighborsRule": {
      "title": "AvoidRecentNeighborsRule",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "title": "Weight",
          "default": 1,
          "type": "integer"
        },
        "relation_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NeighborRelationType"
          }
        },
        "lookback": {
          "title": "Lookback",
          "default": 4,
          "type": "integer"
        },
        "max_recent_count": {
          "title": "Max Recent Count",
          "default": 1,
          "type": "integer"
        },
        "within_distance": {
          "title": "Within Distance",
          "default": 2,
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "CoolingRule": {
      "title": "CoolingRule",
      "description": "Cooling period between repeated desk-mate / neighbor assignments.",
      "type": "object",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "default": false,
          "type": "boolean"
        },
        "weight": {
          "title": "Weight",
          "default": 1,
          "type": "integer"
        },
        "cooling_period": {
          "title": "Cooling Period",
          "default": 3,
          "type": "integer"
        },
        "relation_types": {
          "title": "Relation Types",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "SoftRules": {
      "title": "SoftRules",
      "type": "object",
      "properties": {
        "vision_front": {
          "$ref": "#/definitions/WeightedRule"
        },
        "height_back": {
          "$ref": "#/definitions/WeightedRule"
        },
        "randomize": {
          "$ref": "#/definitions/WeightedRule"
        },
        "score_balance": {
          "$ref": "#/definitions/WeightedRule"
        },
        "score_position": {
          "$ref": "#/definitions/ScorePositionRule"
        },
        "score_distribution": {
          "$ref": "#/definitions/ScoreDistributionRule"
        },
        "mentor_pairing": {
          "$ref": "#/definitions/MentorPairingRule"
        },
        "fair_rotation": {
          "$ref": "#/definitions/FairRotationRule"
        },
        "avoid_recent_neighbors": {
          "$ref": "#/definitions/AvoidRecentNeighborsRule"
        },
        "cooling": {
          "$ref": "#/definitions/CoolingRule"
        }
      },
      "additionalProperties": false
    },
    "GroupRule": {
      "title": "GroupRule",
      "description": "Defines a named group of students for separation or togetherness rules.",
      "type": "object",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "students": {
          "title": "Students",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "separate": {
          "title": "Separate",
          "default": false,
          "type": "boolean"
        },
        "together": {
          "title": "Together",
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "RuleSet": {
      "title": "RuleSet",
      "type": "object",
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "default": 1,
          "type": "integer"
        },
        "seed": {
          "title": "Seed",
          "default": 42,
          "type": "integer"
        },
        "hard": {
          "$ref": "#/definitions/HardRules"
        },
        "soft": {
          "$ref": "#/definitions/SoftRules"
        },
        "groups": {
          "title": "Groups",
          "type": "array",
          "items": {
            "$ref": "#/definitions/GroupRule"
          }
        }
      },
      "additionalProperties": false
    },
    "SeatAssignment": {
      "title": "SeatAssignment",
      "type": "object",
      "properties": {
        "student_key": {
          "title": "Student Key",
          "type": "string"
        },
        "student_name": {
          "title": "Student Name",
          "type": "string"
        },
        "seat_id": {
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "student_key",
        "student_name",
        "seat_id"
      ]
    },
    "SeatingSnapshot": {
      "title": "SeatingSnapshot",
      "type": "object",
      "properties": {
        "schema_version": {
          "title": "Schema Version",
          "default": "1.0",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string",
          "format": "date-time"
        },
        "seed": {
          "title": "Seed",
          "default": 42,
          "type": "integer"
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        },
        "students": {
          "title": "Students",
          "type": "array",
          "items": {
            "$ref": "#/definitions/Student"
          }
        },
        "layout": {
          "$ref": "#/definitions/ClassroomLayout"
        },
        "rules": {
          "$ref": "#/definitions/RuleSet"
        },
        "assignments": {
          "title": "Assignments",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SeatAssignment"
          }
        },
        "solver_status": {
          "title": "Solver Status",
          "type": "string"
        },
        "objective_value": {
          "title": "Objective Value",
          "type": "number"
        },
        "metrics": {
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "students",
        "layout",
        "rules",
        "assignments",
        "solver_status"
      ]
    },
    "ScoreDimension": {
      "title": "ScoreDimension",
      "type": "object",
      "properties": {
        "status": {
          "title": "Status",
          "enum": [
            "available",
            "not_available"
          ],
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "number"
        },
        "weight": {
          "title": "Weight",
          "default": 0.0,
          "type": "number"
        },
        "rating": {
          "title": "Rating",
          "default": "not_available",
          "enum": [
            "high",
            "medium",
            "low",
            "not_available"
          ],
          "type": "string"
        },
        "details": {
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "status"
      ]
    },
    "HardConstraintSummary": {
      "title": "HardConstraintSummary",
      "type": "object",
      "properties": {
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "checked_rule_count": {
          "title": "Checked Rule Count",
          "default": 0,
          "type": "integer"
        },
        "violation_count": {
          "title": "Violation Count",
          "default": 0,
          "type": "integer"
        },
        "violations": {
          "title": "Violations",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "title": "Details",
          "type": "object"
        }
      },
      "required": [
        "satisfied"
      ]
    },
    "ScoreBreakdown": {
      "title": "ScoreBreakdown",
      "type": "object",
      "properties": {
        "fair_rotation_score": {
          "$ref": "#/definitions/ScoreDimension"
        },
        "avoid_recent_neighbors_score": {
          "$ref": "#/definitions/ScoreDimension"
        },
        "score_balance_score": {
          "$ref": "#/definitions/ScoreDimension"
        },
        "height_preference_score": {
          "$ref": "#/definitions/ScoreDimension"
        },
        "vision_preference_score": {
          "$ref": "#/definitions/ScoreDimension"
        },
        "diversity_score": {
          "$ref": "#/definitions/ScoreDimension"
        },
        "stability_score": {
          "$ref": "#/definitions/ScoreDimension"
        },
        "rule_scores": {
          "title": "Rule Scores",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ScoreDimension"
          }
        },
        "hard_constraint_summary": {
          "$ref": "#/definitions/HardConstraintSummary"
        }
      },
      "required": [
        "fair_rotation_score",
        "avoid_recent_neighbors_score",
        "score_balance_score",
        "height_preference_score",
        "vision_preference_score",
        "diversity_score",
        "stability_score",
        "hard_constraint_summary"
      ]
    },
    "PlanScore": {
      "title": "PlanScore",
      "type": "object",
      "properties": {
        "total": {
          "title": "Total",
          "type": "number"
        },
        "breakdown": {
          "$ref": "#/definitions/ScoreBreakdown"
        }
      },
      "required": [
        "total",
        "breakdown"
      ]
    },
    "CandidatePlan": {
      "title": "CandidatePlan",
      "type": "object",
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/definitions/SeatingSnapshot"
        },
        "score": {
          "$ref": "#/definitions/PlanScore"
        },
        "hard_constraints_satisfied": {
          "title": "Hard Constraints Satisfied",
          "type": "boolean"
        },
        "warnings": {
          "title": "Warnings",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "candidate_id",
        "snapshot",
        "score",
        "hard_constraints_satisfied"
      ]
    }
  },
  "x-seattrellis-artifact": "candidate-set",
  "x-seattrellis-schema-version": "0.2.2"
}
