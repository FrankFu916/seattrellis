{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://frankfu916.github.io/seattrellis/schemas/plan-comparison-report.schema.json",
  "title": "SeatTrellis Plan Comparison Report",
  "properties": {
    "schema_version": {
      "default": "0.2.2",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "plan_comparison_report",
      "default": "plan_comparison_report",
      "title": "Kind",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "candidate_count": {
      "title": "Candidate Count",
      "type": "integer"
    },
    "recommended_candidate_id": {
      "title": "Recommended Candidate Id",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/definitions/PlanComparisonEntry"
      },
      "title": "Candidates",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "candidate_count",
    "recommended_candidate_id",
    "candidates"
  ],
  "type": "object",
  "definitions": {
    "PlanComparisonEntry": {
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "total_score": {
          "title": "Total Score",
          "type": "number"
        },
        "score_delta_from_recommended": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Delta From Recommended",
          "type": [
            "number",
            "null"
          ]
        },
        "hard_constraints_satisfied": {
          "title": "Hard Constraints Satisfied",
          "type": "boolean"
        },
        "hard_constraint_checked_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Constraint Checked Count",
          "type": [
            "integer",
            "null"
          ]
        },
        "hard_constraint_violation_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hard Constraint Violation Count",
          "type": [
            "integer",
            "null"
          ]
        },
        "dimension_scores": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Dimension Scores",
          "type": "object"
        },
        "explanations": {
          "items": {
            "$ref": "#/definitions/PlanComparisonExplanation"
          },
          "title": "Explanations",
          "type": "array"
        },
        "advantages": {
          "items": {
            "type": "string"
          },
          "title": "Advantages",
          "type": "array"
        },
        "costs": {
          "items": {
            "type": "string"
          },
          "title": "Costs",
          "type": "array"
        },
        "history_comparison": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "History Comparison",
          "type": "object"
        }
      },
      "required": [
        "candidate_id",
        "total_score",
        "hard_constraints_satisfied"
      ],
      "title": "PlanComparisonEntry",
      "type": "object"
    },
    "PlanComparisonExplanation": {
      "description": "Locale-neutral explanation data for comparison report renderers.",
      "properties": {
        "kind": {
          "enum": [
            "strength",
            "trade_off",
            "best_available"
          ],
          "title": "Kind",
          "type": "string"
        },
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "rating": {
          "enum": [
            "high",
            "medium",
            "low",
            "not_available"
          ],
          "title": "Rating",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dimension",
        "score",
        "rating"
      ],
      "title": "PlanComparisonExplanation",
      "type": "object"
    }
  },
  "x-seattrellis-artifact": "plan-comparison-report",
  "x-seattrellis-schema-version": "0.2.2"
}
