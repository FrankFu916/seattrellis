{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeatTrellis",
  "version": "2.0.0",
  "identifier": "com.seattrellis.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "",
    "frontendDist": "../../clients/web/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* http://localhost:* http://ipc.localhost ipc:; font-src 'self' data:"
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "2.0.0.0"
      }
    }
  }
}
